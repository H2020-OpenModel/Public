###  https://w3id.org/emmo/domain/openmodel#ForceField
:ForceField rdf:type owl:Class ;
              rdfs:subClassOf emmo:EMMO_e5438930_04e7_4d42_ade5_3700d4a52ab7 ;
              skos:prefLabel "ForceField" ;
              emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "a set of parameters and equations for use in molecular mechanics simulations" .


###  https://w3id.org/emmo/domain/openmodel#ForceFieldStyle
:ForceFieldStyle rdf:type owl:Class ;
                   rdfs:subClassOf emmo:EMMO_d1d436e7_72fc_49cd_863b_7bfb4ba5276a ,
                                   :ForceField ;
                   skos:prefLabel "ForceFieldStyle" ;
                   emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Additional settings for the force field. For instance, the Coulomb potential can be evaluated only in real space using a cut-off radius, or can include a long-range solver evaluationg the electrostatic potential in the reciprocal space."@en ;
                   skos:example "atb_long" ,
                                                              "molc_cut" ,
                                                              "molc_long_gamma" .


###  https://w3id.org/emmo/domain/openmodel#GROMOS
:GROMOS rdf:type owl:Class ;
          rdfs:subClassOf :ForceField ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty emmo:EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd ;
                            owl:someValuesFrom emmo:EMMO_84cadc45_6758_46f2_ba2a_5ead65c70213
                          ] ;
          skos:prefLabel "GROMOS" ;
          emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "GROningen MOlecular Simulation (GROMOS) is the name of a force field for molecular dynamics simulation, and a related computer software package. Both are developed at the University of Groningen, and at the Computer-Aided Chemistry Group at the Laboratory for Physical Chemistry at the Swiss Federal Institute of Technology (ETH Zurich)."@en .


###  https://w3id.org/emmo/domain/openmodel#GROMOSParameters
:GROMOSParameters rdf:type owl:Class ;
                    rdfs:subClassOf emmo:EMMO_d1d436e7_72fc_49cd_863b_7bfb4ba5276a ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty [ owl:inverseOf emmo:EMMO_b2282816_b7a3_44c6_b2cb_3feff1ceb7fe
                                                     ] ;
                                      owl:someValuesFrom :GROMOS
                                    ] ;
                    skos:prefLabel "GROMOSParameters" ;
                    emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "The parameters describing a molecule or class of molecules in the GROMOS force field."@en .


###  https://w3id.org/emmo/domain/openmodel#GROMOSSettingsLT
:GROMOSSettingsLT rdf:type owl:Class ;
                    rdfs:subClassOf :LTFile ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_24c71baf_6db6_48b9_86c8_8c70cf36db0c ;
                                      owl:someValuesFrom :GROMOS
                                    ] ;
                    skos:prefLabel "GROMOSSettingsLT" ;
                    skos:example "aa_atb.lt" ;
                    emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """Set of macros defining the potential functions for the GROMOS force field in the LAMMPS Template (LT) syntax. Two macros are available:
* atb_cut : use a cut-off radius for all pairwise interactions.
* atb_long : use a long-range solver (PPPM) for electrostatic interactions."""@en .


###  https://w3id.org/emmo/domain/openmodel#GULP
:GULP rdf:type owl:Class ;
        rdfs:subClassOf emmo:EMMO_8d4962d7_9608_44f7_a2f1_82a4bb173f4a ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty emmo:EMMO_24c71baf_6db6_48b9_86c8_8c70cf36db0c ;
                          owl:someValuesFrom emmo:EMMO_84cadc45_6758_46f2_ba2a_5ead65c70213
                        ] ;
        rdfs:seeAlso "https://gulp.curtin.edu.au/" ;
        skos:prefLabel "GULP" ;
        emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f """GULP - a computer program for the symmetry adapted simulation of solids.
GULP is a program for performing a variety of types of simulation on materials using boundary conditions of 0-D (molecules and clusters), 1-D (polymers), 2-D (surfaces, slabs and grain boundaries), or 3-D (periodic solids). The focus of the code is on analytical solutions, through the use of lattice dynamics, where possible, rather than on molecular dynamics."""@en .


