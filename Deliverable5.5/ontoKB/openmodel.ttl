###  https://w3id.org/emmo/domain/openmodel#OPLS
:OPLS rdf:type owl:Class ;
        rdfs:subClassOf :ForceField ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty emmo:EMMO_a8bd7094_6b40_47af_b1f4_a69d81a3afbd ;
                          owl:someValuesFrom emmo:EMMO_84cadc45_6758_46f2_ba2a_5ead65c70213
                        ] ;
        skos:prefLabel "OPLS" ;
        emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """OPLS4: Improving Force Field Accuracy on Challenging Regimes of Chemical Space.
J. Chem. Theory Comput., 17, 4291–4300 (2021).
https://doi.org/10.1021/acs.jctc.1c00302"""@en ,
                                                   "The OPLS (Optimized Potentials for Liquid Simulations) force field was developed by Prof. William L. Jorgensen at Purdue University and later at Yale University, and is being further developed commercially by Schrödinger, Inc."@en ,
                                                   """The OPLS Force Field for Proteins. Energy Minimizations for Crystals of Cyclic Peptides and Crambin.
J. Am. Chem. Soc., 110, 1657–1666 (1998).
https://doi.org/10.1021/ja00214a001."""@en .


