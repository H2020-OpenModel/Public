###  https://w3id.org/emmo#EMMO_b35e92d7_7fa0_4661_aa5a_5cea7c8e6925
emmo:EMMO_b35e92d7_7fa0_4661_aa5a_5cea7c8e6925 rdfs:domain :URI .


###  https://w3id.org/emmo/domain/openmodel#hasCTX
:hasCTX rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf emmo:EMMO_02face50_43a1_40ce_a909_dfe54d5e186b ;
          rdfs:range xsd:string ;
          skos:prefLabel "hasCTX" ;
          emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A string naming an AiiDA data node"@en .


###  https://w3id.org/emmo/domain/openmodel#hasTempURIValue
:hasTempURIValue rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf emmo:EMMO_b35e92d7_7fa0_4661_aa5a_5cea7c8e6925 ;
                   skos:prefLabel "hasTempURIValue" ;
                   emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The URI value of a temporary resource, which is created on the fly to exchange data between processes."@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/emmo#EMMO_998dd3a0_c85f_4c8d_9fb8_816a93cc3bb8
emmo:EMMO_998dd3a0_c85f_4c8d_9fb8_816a93cc3bb8 rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                             owl:onProperty emmo:EMMO_a592c856_4103_43cf_8635_1982a1e5d5de ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onClass :FileName
                                                           ] .


###  https://w3id.org/emmo/domain/openmodel#AAMDTaskLT
:AAMDTaskLT rdf:type owl:Class ;
              rdfs:subClassOf :LTFile ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty emmo:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
                                owl:someValuesFrom :MolecularDynamicsOutput
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty emmo:EMMO_9380ab64_0363_4804_b13f_3a8a94119a76 ;
                                owl:someValuesFrom :MolecularDynamicsTask
                              ] ;
              skos:prefLabel "AAMDTaskLT" ;
              emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "File in LAMMPS Template (LT) format containing macros to perform different MD simulations (e.g. microcanonical, canonical) for a sample composed of atoms and/or molecules."@en ;
              skos:example "aa_tasks.lt" .


###  https://w3id.org/emmo/domain/openmodel#AiiDA
:AiiDA rdf:type owl:Class ;
         rdfs:subClassOf emmo:EMMO_cbf42aa6_9e11_4be8_932a_ae3c792ab17d ;
         rdfs:seeAlso "https://www.aiida.net/" ;
         skos:prefLabel "AiiDA" ;
         emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "AiiDA is an open-source Python infrastructure to help researchers with automating, managing, persisting, sharing and reproducing the complex workflows associated with modern computational science and all associated data."@en .


###  https://w3id.org/emmo/domain/openmodel#AiiDADataNodes
:AiiDADataNodes rdf:type owl:Class ;
                  rdfs:subClassOf emmo:EMMO_194e367c_9783_4bf5_96d0_9ad597d48d9a ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty emmo:EMMO_4832e353_6a2d_4deb_9a5b_96989afaff2d ;
                                    owl:someValuesFrom :AiiDA
                                  ] ;
                  skos:prefLabel "AiiDADataNodes" ;
                  skos:example "A dataset created during the execution of a workflow. Thedataset is composed of nodes that are created during one step and can be passed to another step using the context, a internal data container."@en .


###  https://w3id.org/emmo/domain/openmodel#Argument
:Argument rdf:type owl:Class ;
            rdfs:subClassOf emmo:EMMO_50ea1ec5_f157_41b0_b46b_a9032f17ca10 ;
            skos:prefLabel "Argument" ;
            emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "An argument is a string of text that is parsed by a computer program and provides additional input to a command."@en .


###  https://w3id.org/emmo/domain/openmodel#AtomicStructureFile
:AtomicStructureFile rdf:type owl:Class ;
                       rdfs:subClassOf emmo:EMMO_998dd3a0_c85f_4c8d_9fb8_816a93cc3bb8 ;
                       skos:prefLabel "AtomicStructureFile" ;
                       emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "A file containing the position and type of one or more atoms. Optionally, the file can include additional information such as periodic repeating unit, symmetry group, molecular topology or connectivity, molecular index, residue type, labels, etc." .


###  https://w3id.org/emmo/domain/openmodel#AtomisticMolecularDynamics
:AtomisticMolecularDynamics rdf:type owl:Class ;
                              rdfs:subClassOf emmo:EMMO_84cadc45_6758_46f2_ba2a_5ead65c70213 ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
                                                owl:someValuesFrom :ForceField
                                              ] ;
                              skos:prefLabel "AtomisticMolecularDynamics" .


###  https://w3id.org/emmo/domain/openmodel#BashScript
:BashScript rdf:type owl:Class ;
              rdfs:subClassOf emmo:EMMO_f84b1b92_1dc8_4146_99f0_b03cd53e455b ;
              skos:prefLabel "BashScript" .


###  https://w3id.org/emmo/domain/openmodel#Bead
:Bead rdf:type owl:Class ;
        rdfs:subClassOf emmo:EMMO_53935db0_af45_4426_b9e9_244a0d77db00 ;
        skos:prefLabel "Bead" ;
        emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A bead is the constituent part of a mesoscopic model. Generally, it represents a group of atoms, for example a monomer in a polymer, or several water molecules in a cluster."@en .


###  https://w3id.org/emmo/domain/openmodel#Bulk
:Bulk rdf:type owl:Class ;
        rdfs:subClassOf :PeriodicBoundaryConditions ;
        skos:prefLabel "Bulk" ;
        emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A bulk geometry in a molecular dynamics simulation is a type of boundary condition that is used to model systems that are infinite in all three dimensions. For example, a bulk geometry can be used to simulate a gas, liquid or solid phase without any external confinement or surface effects. A bulk geometry can be achieved by using periodic boundary conditions that replicate the system in all directions and eliminate any edge effects."@en .


###  https://w3id.org/emmo/domain/openmodel#CIFFile
:CIFFile rdf:type owl:Class ;
           rdfs:subClassOf :AtomicStructureFile ;
           skos:prefLabel "CIFFile" .


###  https://w3id.org/emmo/domain/openmodel#CTX
:CTX rdf:type owl:Class ;
       rdfs:subClassOf :ProgrammingVariable ;
       skos:prefLabel "CTX" ;
       emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "In AiiDA workflow, the context (CTX) is a internal data container that can hold and pass information between steps. It is very usefull for complex workflows."@en .


###  https://w3id.org/emmo/domain/openmodel#CoarseGrainedMolecularDynamics
:CoarseGrainedMolecularDynamics rdf:type owl:Class ;
                                  rdfs:subClassOf emmo:EMMO_53935db0_af45_4426_b9e9_244a0d77db00 ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f ;
                                                    owl:someValuesFrom :ForceField
                                                  ] ;
                                  skos:prefLabel "CoarseGrainedMolecularDynamics" .


###  https://w3id.org/emmo/domain/openmodel#Command
:Command rdf:type owl:Class ;
           rdfs:subClassOf emmo:EMMO_50ea1ec5_f157_41b0_b46b_a9032f17ca10 ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty emmo:EMMO_7fb7fe7e_bdf9_4eeb_adad_e384dd5285c6 ;
                             owl:someValuesFrom emmo:EMMO_8681074a_e225_4e38_b586_e85b0f43ce38
                           ] ;
           skos:prefLabel "Command" ;
           emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A command is a means of interacting with a computer program with commands from a user or client in the form of lines of text. Certain commands can take additional arguments as input."@en ;
           skos:example "ls -l"@en .


###  https://w3id.org/emmo/domain/openmodel#CompressionMDT
:CompressionMDT rdf:type owl:Class ;
                  rdfs:subClassOf :MolecularDynamicsTask ;
                  skos:prefLabel "CompressionMDT" ;
                  emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """Initialise the run section of a MD simulation, its MolecularDynamicsOutput, and perform time integration in the canonical ensemble using a Langevin thermostat.

In addition, compress an isotropic sample to a target volume at low temperature, followed by heating to a target temperature at the target volume. Use a /cut pair style to speed-up the calculations.
NOTE: an isotropic shrinking of 0.95 per step is assumed when computing the compression steps."""@en .


###  https://w3id.org/emmo/domain/openmodel#ComputationalFluidDynamics
:ComputationalFluidDynamics rdf:type owl:Class ;
                              rdfs:subClassOf emmo:EMMO_4456a5d2_16a6_4ee1_9a8e_5c75956b28ea ;
                              skos:prefLabel "ComputationalFluidDynamics" ;
                              emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Computational fluid dynamics is a branch of fluid mechanics that uses numerical analysis and data structures to analyze and solve problems that involve fluid flows. Computers are used to perform the calculations required to simulate the free-stream flow of the fluid, and the interaction of the fluid with surfaces defined by boundary conditions."@en .


###  https://w3id.org/emmo/domain/openmodel#ConfigurationInteraction
:ConfigurationInteraction rdf:type owl:Class ;
                            rdfs:subClassOf :PostHartreeFock ;
                            skos:prefLabel "ConfigurationInteraction" ;
                            emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Configuration interaction (CI) is a post-Hartree–Fock linear variational method for solving the nonrelativistic Schrödinger equation within the Born–Oppenheimer approximation for a quantum chemical multi-electron system." .


###  https://w3id.org/emmo/domain/openmodel#CorrelationLength
:CorrelationLength rdf:type owl:Class ;
                     rdfs:subClassOf emmo:EMMO_d1d436e7_72fc_49cd_863b_7bfb4ba5276a ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty emmo:EMMO_faf79f53_749d_40b2_807c_d34244c192f4 ;
                                       owl:allValuesFrom xsd:int
                                     ] ;
                     skos:prefLabel "CorrelationLength" ;
                     emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """In LAMMPS, the thermodynamic output is averaged and returned with *fixes* whose general syntax is:
fix ID group-ID ave/time Nevery Nrepeat Nfreq value1 value2 ... keyword args

The correlation length corresponds to Nrepeat and is the number of times to use input values for calculating averages."""@en ;
                     skos:example "fix BOX all ave/time $s ${cl} $d v_dx mode scalar ave running" ;
                     emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Correlation length, used to sample the thermodynamic output."@en .


###  https://w3id.org/emmo/domain/openmodel#CoupledCluster
:CoupledCluster rdf:type owl:Class ;
                  rdfs:subClassOf :PostHartreeFock ;
                  skos:prefLabel "CoupledCluster" ;
                  emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Coupled cluster (CC) is a numerical technique used for describing many-body systems. Its most common use is as one of several post-Hartree–Fock ab initio quantum chemistry method. Coupled cluster essentially takes the basic Hartree–Fock molecular orbital method and constructs multi-electron wavefunctions using the exponential cluster operator to account for electron correlation."@en .


###  https://w3id.org/emmo/domain/openmodel#CutoffRadius
:CutoffRadius rdf:type owl:Class ;
                rdfs:subClassOf emmo:EMMO_d1d436e7_72fc_49cd_863b_7bfb4ba5276a ;
                skos:prefLabel "CutoffRadius" ;
                emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "The pairwise interactions are computed only if the distance between a pair of particles is smaller than the cut-off radius."@en ;
                emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "The distance (in length units) at which pairwise interactions are cut-off."@en .


###  https://w3id.org/emmo/domain/openmodel#DCDFile
:DCDFile rdf:type owl:Class ;
           rdfs:subClassOf :AtomicStructureFile ;
           skos:prefLabel "DCDFile" .


###  https://w3id.org/emmo/domain/openmodel#DLite
:DLite rdf:type owl:Class ;
         rdfs:subClassOf emmo:EMMO_cbf42aa6_9e11_4be8_932a_ae3c792ab17d ;
         rdfs:seeAlso "https://sintef.github.io/dlite/" ;
         skos:prefLabel "DLite" ;
         emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A lightweight data-centric framework for semantic interoperability."@en .


###  https://w3id.org/emmo/domain/openmodel#DUMPFile
:DUMPFile rdf:type owl:Class ;
            rdfs:subClassOf :AtomicStructureFile ,
                            :LAMMPSFile ;
            skos:prefLabel "DUMPFile" ;
            emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Output file containing the trajectory of a Molecular Dynamics simulation, i.e. a series of snapshots storing the state of a system at different time. A typical snapshot of a system comprises position and velocity of particles, but it may also include orientation and angular velocity of finite-size particles." .


###  https://w3id.org/emmo/domain/openmodel#DataBasedModel
:DataBasedModel rdf:type owl:Class ;
                  rdfs:subClassOf emmo:EMMO_90f18cf0_1225_4c64_b5f8_f65cd7f992c5 ;
                  skos:prefLabel "DataBasedModel" .


###  https://w3id.org/emmo/domain/openmodel#DataParsing
:DataParsing rdf:type owl:Class ;
               rdfs:subClassOf emmo:EMMO_cbf42aa6_9e11_4be8_932a_ae3c792ab17d ;
               skos:prefLabel "DataParsing" ;
               emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "A software or script that parses a data file and returns data in the form of scalars, arrays, or matrices."@en .


###  https://w3id.org/emmo/domain/openmodel#DensityFunctionalTheory
:DensityFunctionalTheory rdf:type owl:Class ;
                           rdfs:subClassOf emmo:EMMO_6eca09be_17e9_445e_abc9_000aa61b7a11 ;
                           skos:prefLabel "DensityFunctionalTheory" .


###  https://w3id.org/emmo/domain/openmodel#DensityMoltemplateDP
:DensityMoltemplateDP rdf:type owl:Class ;
                        rdfs:subClassOf :MoltemplateDataProcessing ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty emmo:EMMO_36e69413_8c59_4799_946c_10b05d266e22 ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :MoltemplateWaterDataSet
                                        ] ;
                        skos:prefLabel "WaterDensityMoltemplateDP" ;
                        emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "This process takes a specific dataset as its input."@en .


###  https://w3id.org/emmo/domain/openmodel#DiffusionMoleculeMD
:DiffusionMoleculeMD rdf:type owl:Class ;
                       rdfs:subClassOf :MolecularDynamicsOutput ;
                       skos:prefLabel "DiffusionMoleculeMD" ;
                       emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """Compute standard thermodynamic quantities, plus:
* the inter-molecular energy for systems with long-range electrostatics
* the total mean-square displacement (MSD) computed on the centre of mass of individual molecules.
* The diffusion coefficient for a system with 3D bounday conditions.

The thermodynamics output is as follows:
* Simulation step
* Total Energy
* van deer Walls Energy (short-range)
* Coulomb Energy (real part of the potential)
* Long-range Coulomb Energy (reciprocal part of the potential)
* Bond Energy
* Angle Energy
* Dihedral Energy
* Improper Energy
* Kinetic Energy
* Potential Energy
* Temperature
* Pressure
* Volume
* Density
* Inter-molecular Energy
* Averaged MSD
* Diffusion Coefficient
* Elapsed CPU time.

Save a MD trajectory as a separate file (DCD or DUMP formats)."""@en .


###  https://w3id.org/emmo/domain/openmodel#EquilibrationSteps
:EquilibrationSteps rdf:type owl:Class ;
                      rdfs:subClassOf :Steps ;
                      skos:prefLabel "EquilibrationSteps" ;
                      emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Number of steps used for a system to reach thermodynamic equilibrium."@en ;
                      emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Number of steps used to integrate the equation of motions in a Molecular Dynamics simulation. The ProductionSteps*Timestep gives the actual time span of the simulation."@en .


###  https://w3id.org/emmo/domain/openmodel#ExecFlowWrapper
:ExecFlowWrapper rdf:type owl:Class ;
                   rdfs:subClassOf emmo:EMMO_4299e344_a321_4ef2_a744_bacfcce80afc ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty emmo:EMMO_36e69413_8c59_4799_946c_10b05d266e22 ;
                                     owl:someValuesFrom :AiiDADataNodes
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
                                     owl:someValuesFrom emmo:EMMO_194e367c_9783_4bf5_96d0_9ad597d48d9a
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
                                     owl:someValuesFrom :AiiDADataNodes
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty emmo:EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :AiiDA
                                   ] ;
                   skos:prefLabel "ExecFlowWrapper" ;
                   emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A task which is executed in ExecFlow using a wrapper to an external software."@en .


