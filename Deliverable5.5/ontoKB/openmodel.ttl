###  https://w3id.org/emmo/domain/openmodel#LAMMPSSimulation
:LAMMPSSimulation rdf:type owl:Class ;
                    rdfs:subClassOf emmo:EMMO_4299e344_a321_4ef2_a744_bacfcce80afc ,
                                    emmo:EMMO_e97af6ec_4371_4bbc_8936_34b76e33302f ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
                                      owl:someValuesFrom :DCDFile
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
                                      owl:someValuesFrom :DUMPFile
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 ;
                                      owl:someValuesFrom :LAMMPSLog
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_36e69413_8c59_4799_946c_10b05d266e22 ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :LAMMPSDataSet
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty emmo:EMMO_ae2d1a96_bfa1_409a_a7d2_03d69e8a125a ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass :LAMMPS
                                    ] ;
                    skos:prefLabel "LAMMPSSimulation"@en ;
                    emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 """A typical LAMMPS job is launched from the command line and requires to specify an input and output file names, eg
$ lmp_23Jun22 -in sim.in -l sim.log
or
$ mpirun -np 32 lmp_23Jun22 -in sim.in -l sim.log

However, additional files may be called by the input file sim.in""" .


###  https://w3id.org/emmo/domain/openmodel#LAMMPSTemplate
:LAMMPSTemplate rdf:type owl:Class ;
                  rdfs:subClassOf emmo:EMMO_3c5b33a1_4f28_41f9_b725_1994df79bf55 ,
                                  _:genid45 ;
                  rdfs:seeAlso "https://www.moltemplate.org/"^^xsd:anyURI ;
                  skos:altLabel "LAMMPSTemplate" ,
                                "LTFile" ;
                  skos:prefLabel "MoltemplateScript" ;
                  emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A moltemplate LT file containing molecule definitions to generate a valid input deck for LAMMPS." ;
                  emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "The LAMMPS-template (LT) format is used by moltemplate to create template files containing all the information required to create a particular molecule or input for LAMMPS (including coordinates, bond-topology, angles, force-field parameters, constraints, groups and fixes). LT files are text-based and are interpreted by the program Moltemplate. The format is agnostic to the LAMMPS syntax."@en .

_:genid45 rdf:type owl:Restriction ;
           owl:onProperty emmo:EMMO_7fb7fe7e_bdf9_4eeb_adad_e384dd5285c6 ;
           owl:allValuesFrom :Moltemplate .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :LAMMPSTemplate ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid45 ;
   emmo:EMMO_c7b62dd7_063a_4c2a_8504_42f7264ba83f "Is this axiom correct to define a property of the scripting language? Or, should it be stated for Moltemplate Files?"@en
 ] .


